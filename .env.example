# ============================================================
# Cloud AI — configuração (copie para ".env" e ajuste)
#   cp .env.example .env
# NUNCA faça commit do arquivo .env. As chaves ficam somente no servidor.
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# Segredo para assinar as sessões (OBRIGATÓRIO em produção, mínimo 32 caracteres).
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Caminho do banco SQLite (padrão: server/data/cloud-ai.db)
# DATABASE_PATH=./data/cloud-ai.db

# Em produção atrás de HTTPS o cookie de sessão é "Secure" automaticamente.
# Se estiver atrás de proxy reverso (Nginx, Render, Railway, Cloudflare...), informe quantos proxies confiar:
# TRUST_PROXY=1

# Permite novos cadastros? (false = apenas usuários já existentes)
ALLOW_REGISTRATION=true

# --- Provedores de IA (configure pelo menos um) ---
# Cada provedor só é habilitado se tiver chave/URL E ao menos um modelo.
# Os modelos aparecem na interface como "provedor:modelo". Use nomes de modelos válidos na SUA conta.

# OpenAI (ou qualquer API compatível: mude OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODELS=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION=true

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-sonnet-5-5
# ANTHROPIC_VISION=true

# OpenRouter (acesso a vários modelos com uma chave)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openai/gpt-4o-mini
# OPENROUTER_VISION=true

# Groq (informe os modelos disponíveis na sua conta)
GROQ_API_KEY=
GROQ_MODELS=
# GROQ_VISION=false

# Ollama / modelos locais (API compatível com OpenAI em /v1). Exemplo:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODELS=llama3.2
# OLLAMA_VISION=false

# Provedor genérico compatível com a API de chat da OpenAI (LM Studio, vLLM, Together, etc.)
# CUSTOM_LABEL=Meu provedor
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_MODELS=nome-do-modelo
# CUSTOM_VISION=false

# Modelo selecionado por padrão (formato provedor:modelo). Se vazio, usa o primeiro configurado.
# DEFAULT_MODEL=openai:gpt-4o-mini

# --- Ajustes opcionais ---
# Prompt de sistema aplicado a todas as conversas
# SYSTEM_PROMPT=Você é o Cloud AI...
# MAX_HISTORY_MESSAGES=40      # mensagens anteriores enviadas ao modelo como contexto
# MAX_OUTPUT_TOKENS=4096       # usado pelo adaptador da Anthropic (obrigatório na API deles)
# UPSTREAM_TIMEOUT_MS=60000    # tempo máximo para o provedor começar a responder

# --- Limites de requisições ---
# RATE_LIMIT_API=600           # requisições gerais por IP a cada 15 min
# RATE_LIMIT_AUTH=30           # tentativas de login/cadastro por IP a cada 15 min
# RATE_LIMIT_CHAT=20           # mensagens por usuário por minuto
# BCRYPT_ROUNDS=12
